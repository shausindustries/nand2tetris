// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    Mux(a=a[0],b=b[0],out=out1,sel=sel[0]);
    Mux(a=c[0],b=d[0],out=out2,sel=sel[0]);
    Mux(a=out1,b=out2,out=out[0],sel=sel[1]);

    Mux(a=a[1],b=b[1],out=out3,sel=sel[0]);
    Mux(a=c[1],b=d[1],out=out4,sel=sel[0]);
    Mux(a=out3,b=out4,out=out[1],sel=sel[1]);

    Mux(a=a[2],b=b[2],out=out5,sel=sel[0]);
    Mux(a=c[2],b=d[2],out=out6,sel=sel[0]);
    Mux(a=out5,b=out6,out=out[2],sel=sel[1]);

    Mux(a=a[3],b=b[3],out=out7,sel=sel[0]);
    Mux(a=c[3],b=d[3],out=out8,sel=sel[0]);
    Mux(a=out7,b=out8,out=out[3],sel=sel[1]);

    Mux(a=a[4],b=b[4],out=out9,sel=sel[0]);
    Mux(a=c[4],b=d[4],out=out10,sel=sel[0]);
    Mux(a=out9,b=out10,out=out[4],sel=sel[1]);

    Mux(a=a[5],b=b[5],out=out11,sel=sel[0]);
    Mux(a=c[5],b=d[5],out=out12,sel=sel[0]);
    Mux(a=out11,b=out12,out=out[5],sel=sel[1]);

    Mux(a=a[6],b=b[6],out=out13,sel=sel[0]);
    Mux(a=c[6],b=d[6],out=out14,sel=sel[0]);
    Mux(a=out13,b=out14,out=out[6],sel=sel[1]);

    Mux(a=a[7],b=b[7],out=out15,sel=sel[0]);
    Mux(a=c[7],b=d[7],out=out16,sel=sel[0]);
    Mux(a=out15,b=out16,out=out[7],sel=sel[1]);

    Mux(a=a[8],b=b[8],out=out17,sel=sel[0]);
    Mux(a=c[8],b=d[8],out=out18,sel=sel[0]);
    Mux(a=out17,b=out18,out=out[8],sel=sel[1]);

    Mux(a=a[9],b=b[9],out=out19,sel=sel[0]);
    Mux(a=c[9],b=d[9],out=out20,sel=sel[0]);
    Mux(a=out19,b=out20,out=out[9],sel=sel[1]);

    Mux(a=a[10],b=b[10],out=out21,sel=sel[0]);
    Mux(a=c[10],b=d[10],out=out22,sel=sel[0]);
    Mux(a=out21,b=out22,out=out[10],sel=sel[1]);

    Mux(a=a[11],b=b[11],out=out23,sel=sel[0]);
    Mux(a=c[11],b=d[11],out=out24,sel=sel[0]);
    Mux(a=out23,b=out24,out=out[11],sel=sel[1]);

    Mux(a=a[12],b=b[12],out=out25,sel=sel[0]);
    Mux(a=c[12],b=d[12],out=out26,sel=sel[0]);
    Mux(a=out25,b=out26,out=out[12],sel=sel[1]);

    Mux(a=a[13],b=b[13],out=out27,sel=sel[0]);
    Mux(a=c[13],b=d[13],out=out28,sel=sel[0]);
    Mux(a=out27,b=out28,out=out[13],sel=sel[1]);

    Mux(a=a[14],b=b[14],out=out29,sel=sel[0]);
    Mux(a=c[14],b=d[14],out=out30,sel=sel[0]);
    Mux(a=out29,b=out30,out=out[14],sel=sel[1]);

    Mux(a=a[15],b=b[15],out=out31,sel=sel[0]);
    Mux(a=c[15],b=d[15],out=out32,sel=sel[0]);
    Mux(a=out31,b=out32,out=out[15],sel=sel[1]);
}