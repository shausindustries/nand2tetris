// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    And16(a=in,b=false,out=o1);
    Register(in=in,load=load,out=o2);
    Mux16(a=o1,b=o2,sel=load,out=o3);
    Inc16(in=o3,out=o4);
    Or16(a=o4,b=false,out=out);
}